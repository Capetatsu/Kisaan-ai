# Database connection string
# For local Docker PostgreSQL: postgresql://postgres:postgres@db:5432/kisaan
# For Neon (cloud): postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/kisaan

# JWT secret key - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS origins (comma-separated for multiple)
CORS_ORIGINS=["*"]

# External API keys (optional - app has fallbacks)
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Default location for weather fallback
DEFAULT_LATITUDE=22.7196
DEFAULT_LONGITUDE=75.8577